{
  "name": "banking360",
  "version": "1.0.0",
  "private": true,
  "description": "Banking360 - Enterprise Digital Banking Platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ui": "turbo run test:ui",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo dist build",
    "db:up": "docker compose -f docker-compose.yml up -d postgres redis kafka",
    "db:down": "docker compose -f docker-compose.yml down postgres redis kafka",
    "services:up": "docker compose -f docker-compose.yml up -d",
    "services:down": "docker compose -f docker-compose.yml down",
    "frontend:dev": "turbo run dev --filter=customer-shell --filter=admin-shell",
    "backend:dev": "turbo run dev --filter=api-gateway --filter=identity-service --filter=customer-service --filter=product-service --filter=card-service --filter=transaction-service --filter=payment-service --filter=ledger-service --filter=reward-service --filter=emi-service --filter=loan-service --filter=fastag-service --filter=offer-service --filter=notification-service --filter=service-request-service --filter=profile-service --filter=cms-service --filter=configuration-service --filter=feature-flag-service --filter=admin-service --filter=audit-service --filter=reporting-service"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "prettier": "^3.2.0",
    "tailwindcss": "3",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@module-federation/vite": "^1.0.0"
  }
}